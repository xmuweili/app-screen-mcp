{
  "name": "app-screen-mcp",
  "version": "1.0.0",
  "description": "MCP server for iOS Simulator automation — accessibility tree, screenshot, tap/swipe/type, and AI screen perception tools",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "node --test --import tsx/esm tests/demo-app.test.ts"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "ios",
    "simulator",
    "screenshot",
    "accessibility",
    "automation",
    "xcrun",
    "idb",
    "ai"
  ],
  "author": "xmuweili",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xmuweili/app-screen-mcp.git"
  },
  "homepage": "https://github.com/xmuweili/app-screen-mcp#readme",
  "bugs": {
    "url": "https://github.com/xmuweili/app-screen-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "bin": {
    "app-screen-mcp": "./dist/index.js"
  }
}
